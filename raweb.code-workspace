    {
      "path": "dotnet/RAWeb.DesktopApp.Installer",
      "name": "Web App » Desktop » Installer"
    },
    {
      "path": "workers/raweb-install-worker",
      "name": "Workers » Install"
    },
    {
      "path": ".github/actions/test-android-windows-app",
      "name": "E2E » Android"
    },
    {
      "path": "dotnet/RAWeb.Server.Management",
      "name": "Server » Management"
    },
    {
      "path": "dotnet/RAWeb.Server.Management.ServiceHost",
      "name": "Server » Management » Service"
    },
    {
      "path": "dotnet/RAWeb.Server.Installer",
      "name": "Server » Installer"
    },
    {
      "path": "dotnet/RAWeb.Server.Installer.Stub",
      "name": "Server » Installer » Stub"
    },
    {
      "path": "dotnet/RAWeb.Server.Utilities",
      "name": "Server » Utilities"
    },
    {
      "path": "dotnet/RAWeb.Server",
      "name": "Server",
    },
  ],
  "settings": {
    "files.exclude": {
      "frontend/": true,
      // ".vscode/": true,
      "workers/": true,
      "dotnet/RAWeb.Server/": true,
      "dotnet/RAWeb.Server.Installer/": true,
      "dotnet/RAWeb.Server.Installer.Stub/": true,
      "dotnet/RAWeb.Server.Utilities/": true,
      "dotnet/RAWeb.Server.Management/": true,
      "dotnet/RAWeb.Server.Management.ServiceHost/": true,
      "dotnet/RAWeb.DesktopApp/": true,
      "dotnet/RAWeb.DesktopApp.Installer/": true,
    },
    "dotnet.formatting.organizeImportsOnFormat": true,
    "dotnet.codeLens.enableReferencesCodeLens": false,
    "dotnet.defaultSolution": "RAWeb.slnx",
    "terminal.integrated.env.windows": {
      // ensure that command-line binaries are in the PATH (for running commands like `pnpm`)
      "Path": "${workspaceFolder:Web App}\\bin;${env:Path}"
    },
    "terminal.integrated.profiles.windows": {
      "PowerShell (RAWeb)": {
        "source": "PowerShell",
        // skip the user's PowerShell profile so it can't override the PATH set via terminal.integrated.env.windows above
        "args": [
          "-NoExit",
          "-NoProfile"
        ]
      }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell (RAWeb)",
    "[xml]": {
      "editor.formatOnSave": false,
      "editor.formatOnPaste": false,
      "editor.formatOnType": false
    },
    "editor.formatOnSave": true,
  }
}
