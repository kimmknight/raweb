<Window x:Class="RAWeb.Server.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="RAWeb Installer"
        Width="760"
        Height="700"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0"
            Padding="32,28,32,20">
      <StackPanel>
        <TextBlock x:Name="TitleText"
                   FontSize="28"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="DescriptionText"
                   Margin="0,6,0,0"
                   Opacity="0.75"
                   TextWrapping="Wrap"
                   FontSize="14"/>
      </StackPanel>
    </Border>

    <!-- Active page -->
    <ui:Frame x:Name="PageHost"
              Grid.Row="1"
              Margin="32,0,32,0"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              NavigationUIVisibility="Hidden"/>

    <!-- Footer -->
    <Border Grid.Row="2"
            Padding="32,20,32,24"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
      <Grid>
        <TextBlock x:Name="StepText"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   FontSize="12"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button x:Name="BackButton"
                  Content="Back"
                  Click="OnBack"
                  MinWidth="96"
                  Margin="0,0,8,0"/>
          <Button x:Name="CancelButton"
                  Content="Cancel"
                  Click="OnCancel"
                  MinWidth="96"
                  Margin="0,0,8,0"/>
          <Button x:Name="SecondaryActionButton"
                  Click="OnSecondaryAction"
                  MinWidth="96"
                  Margin="0,0,8,0"/>
          <Button x:Name="NextButton"
                  Content="Next"
                  Click="OnNext"
                  MinWidth="120"
                  Style="{DynamicResource AccentButtonStyle}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
