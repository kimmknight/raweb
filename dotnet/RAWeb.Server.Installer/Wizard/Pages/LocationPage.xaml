<wizard:WizardPage
  x:Class="RAWeb.Server.Installer.Wizard.Pages.LocationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
  xmlns:wizard="clr-namespace:RAWeb.Server.Installer.Wizard">

  <StackPanel>
    <TextBlock
      Margin="0,0,0,20"
      FontSize="14"
      LineHeight="22"
      TextWrapping="Wrap">
      Each version is copied into its own timestamped folder inside this directory, which allows us to roll back to the current version if an upgrade fails.
    </TextBlock>

    <StackPanel
      x:Name="UpgradePanel"
      Margin="0,0,0,20"
      Visibility="Collapsed">
      <RadioButton
        x:Name="KeepLocationRadio"
        Margin="0,0,0,4"
        Checked="OnLocationChoiceChanged"
        Content="Keep the current location"
        GroupName="LocationChoice"
        IsChecked="True"
        MouseDoubleClick="OnKeepLocationDoubleClick" />
      <TextBlock
        x:Name="ExistingLocationText"
        Margin="24,0,0,12"
        FontFamily="Cascadia Mono, Consolas, monospace"
        FontSize="12"
        Opacity="0.6"
        TextWrapping="Wrap" />
      <RadioButton
        x:Name="ChooseLocationRadio"
        Checked="OnLocationChoiceChanged"
        Content="Choose a different location"
        GroupName="LocationChoice" />
    </StackPanel>

    <StackPanel x:Name="CustomLocationPanel">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          x:Name="InstallDirBox"
          Grid.Column="0"
          Padding="10,8"
          FontSize="14"
          TextChanged="OnPathChanged" />
        <Button
          Grid.Column="1"
          MinWidth="96"
          Margin="8,0,0,0"
          Click="OnBrowse"
          Content="Browse..." />
      </Grid>

      <ui:HyperlinkButton
        x:Name="ResetLink"
        Margin="0,6,0,0"
        Padding="0,4"
        HorizontalAlignment="Left"
        Click="OnResetToDefault"
        Content="Use the default location" />

      <ui:InfoBar
        x:Name="WarningBar"
        Margin="0,12,0,0"
        IsClosable="False"
        IsOpen="False"
        Severity="Warning" />

      <Border
        Margin="0,16,0,0"
        Padding="20"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel>
          <TextBlock
            Margin="0,0,0,6"
            FontSize="12"
            Opacity="0.6"
            Text="This version will be stored in" />
          <TextBlock
            x:Name="VersionedPathPreview"
            FontFamily="Cascadia Mono, Consolas, monospace"
            FontSize="13"
            TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</wizard:WizardPage>
